Cell[CellGroupData[{

Cell["Figure 7. Beam conditions", "Section",ExpressionUUID->"cfedca3a-49f8-410c-83da-db8b034db0f6"],

Cell["\<\
fig7Panels = Module[{a, b},
   a = finishPanel[
     linePanel[
      Table[Module[{c = loadCSV[csvPath[r, \"event_info\", \"nPV_True.csv\"]]},
        <|\"points\" -> SortBy[Transpose[{N[c[\"value\"]], c[\"count\"]}], \
First],
          \"label\" -> runLabels[r], \"colour\" -> runColours[r]|>], {r, \
runs}],
      \"XLabel\" -> \"Interactions per crossing\", \"YLabel\" -> \"Events\", \
\"Markers\" -> True,
      \"LegendPos\" -> {0.03, 0.96}, \"LegendAlign\" -> {Left, Top},
      \"Padding\" -> {{175, 22}, {84, 16}}]];
   b = finishPanel[
     linePanel[
      Table[Module[{c = loadCSV[csvPath[r, \"lumi_profile.csv\"]]},
        <|\"points\" -> SortBy[Transpose[{c[\"lumi\"], c[\"events\"]}], First],
          \"label\" -> runLabels[r], \"colour\" -> runColours[r]|>], {r, \
runs}],
      \"XLabel\" -> \"Luminosity section\", \"YLabel\" -> \"Events per \
luminosity section\",
      \"LegendPos\" -> {0.97, 0.03}, \"LegendAlign\" -> {Right, Bottom},
      \"Padding\" -> {{175, 22}, {84, 16}}]];
   exportFigure[a, \"fig7_pileup\"];
   exportFigure[b, \"fig7_lumi_profile\"];
   {a, b}];\
\>", "Input",
 CellChangeTimes->{{3.996596619105042*^9, 3.996596619288262*^9}},
 CellLabel->"In[97]:=",ExpressionUUID->"8fb5415a-2ff8-45bb-af35-1ba47a36a4b7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Figure 8. Signal against background separation", "Section",ExpressionUUID->"1d84886e-1511-496a-9f38-5c9ac8d826b0"],

Cell["\<\
fig8Panels = Module[{acc, ord, labels, colours, a, jets, groups, sub, rng, \
series, b},
   acc = loadCSV[csvPath[\"campaign\", \"l1bit_accept.csv\"]];
   ord = Reverse[Ordering[acc[\"accept\"]]];
   labels = If[KeyExistsQ[fig8Samples, #], Style[sampleLabel[#], \
fig8Samples[#], Bold], sampleLabel[#]] & /@
     acc[\"sample\"][[ord]];
   colours = Lookup[fig8Samples, acc[\"sample\"][[ord]], tolVibrant[\"grey\"]];
   a = finishPanel[
     dotChart[labels,
      {<|\"values\" -> acc[\"accept\"][[ord]], \"dy\" -> 0, \"colour\" -> \
colours, \"label\" -> \"\"|>},
      \"XLabel\" -> \"Fraction of events accepted\", \"Size\" -> {1180, 820}, \
\"NameSize\" -> 15,
      \"MarkerSize\" -> 7, \"Padding\" -> {{470, 34}, {84, 16}}], True];
   jets = loadCSV[csvPath[\"campaign\", \"jets_jetIEt.csv\"]];
   groups = GroupBy[Transpose[{jets[\"sample\"], jets[\"value\"], \
jets[\"count\"]}], First -> Rest];
   sub = groups /@ Keys[fig8Samples];
   rng = MinMax[Join @@ (#[[All, 1]] & /@ sub)];
   series = Table[Module[{g = sub[[i]], eh},
      eh = rebin[g[[All, 1]], g[[All, 2]], rng];
      <|\"edges\" -> 0.5 eh[[1]], \"heights\" -> eh[[2]]/Total[g[[All, 2]]],
        \"label\" -> sampleLabel[Keys[fig8Samples][[i]]], \"colour\" -> \
Values[fig8Samples][[i]]|>],
     {i, Length[fig8Samples]}];
   b = finishPanel[
     spectrumPanel[series, \"XLabel\" -> ptLabel[\"Jet\"], \"YLabel\" -> \
\"Fraction of jets\",
      \"Size\" -> {1180, 850}, \"LegendSize\" -> 15, \"Padding\" -> {{140, \
30}, {84, 16}}], True];
   exportFigure[a, \"fig8_accept\"];
   exportFigure[b, \"fig8_jetIEt\"];
   {a, b}];\
\>", "Input",
 CellChangeTimes->{{3.996596621905046*^9, 3.9965966221319427`*^9}},
 CellLabel->"In[98]:=",ExpressionUUID->"9791e272-416f-45bc-963f-06f744d90bbd"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
