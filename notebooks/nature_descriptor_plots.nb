Cell[CellGroupData[{

Cell["Loading", "Subtitle",ExpressionUUID->"78213c59-a3a4-4cbc-b823-fcafd6e875c2"],

Cell["\<\
loadCSV[path_] := Module[{rows},
  rows = Import[path, \"CSV\"];
  If[StringQ[rows[[1, 1]]] && StringStartsQ[rows[[1, 1]], \"#\"], rows = \
Rest[rows]];
  AssociationThread[rows[[1]] -> Transpose[Rest[rows]]]];

scaleOf[csv_] := With[{i = First[FirstPosition[csv[\"value\"], v_ /; v != 0]]},
  csv[\"physical\"][[i]]/csv[\"value\"][[i]]];\
\>", "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"83b1bcc4-85fe-4b97-93a5-1b6b52c01efa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Binning", "Subtitle",ExpressionUUID->"02adb5d1-d406-4bf7-a24b-45f0a387080c"],

Cell["\<\
rebin[vals_, cnts_, range_: Automatic] := Module[{lo, hi, step, n, h},
  {lo, hi} = Replace[range, Automatic :> MinMax[vals]];
  step = Max[1, Ceiling[(hi - lo + 1)/256]];
  n = Ceiling[(hi - lo + 1)/step];
  h = ConstantArray[0., n];
  MapThread[(h[[Min[Floor[(#1 - lo)/step] + 1, n]]] += #2) &, {vals, cnts}];
  {lo - 0.5 + step*Range[0, n], h}];

stepSegments[edges_, heights_, base_: None] := Module[{groups, seg},
  groups = Select[SplitBy[Range[Length[heights]], heights[[#]] > 0 &], \
heights[[First[#]]] > 0 &];
  Table[
   seg = Join @@ Table[{{edges[[j]], heights[[j]]}, {edges[[j + 1]], \
heights[[j]]}}, {j, g}];
   If[base === None, seg,
    Join[{{edges[[First[g]]], base}}, seg, {{edges[[Last[g] + 1]], base}}]],
   {g, groups}]];\
\>", "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"e03c1c87-c06f-4e98-aa7b-324da24aeeb5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Ticking", "Subtitle",ExpressionUUID->"218b0c39-5be8-4e21-ba98-1b7ab0351ca0"],

Cell["\<\
heros[sz_] := Directive[Black, FontFamily -> \"TeX Gyre Heros\", FontSize -> \
sz,
   PrivateFontOptions -> {\"OperatorSubstitution\" -> False}];
herosFont = {FontFamily -> \"TeX Gyre Heros\"};
tickLabel[x_] := If[Round[x] == x, ToString[Round[x]], \
ToString[NumberForm[N[x], {Infinity, 2}]]];
blankTicks[t_] := ReplacePart[#, 2 -> \"\"] & /@ t;

linTicks[min_, max_, label_: True] := Module[{maj, d, minor},
  maj = Select[N[FindDivisions[{min, max}, 6]], min - 10.^-9 <= # <= max + \
10.^-9 &];
  If[maj === {}, maj = N[Subdivide[min, max, 5]]];
  d = If[Length[maj] > 1, maj[[2]] - maj[[1]], (max - min)/5.];
  minor = Select[Flatten[Table[m + d k/5, {m, Prepend[maj, First[maj] - d]}, \
{k, 1, 4}]], min <= # <= max &];
  Join[Table[{m, If[label, Style[tickLabel[m], heros[22]], \"\"], {0.014, \
0}}, {m, maj}],
   Table[{m, \"\", {0.007, 0}}, {m, minor}]]];

intTicks[lo_, hi_] := With[{d = Max[1, Ceiling[(hi - lo + 1)/7]]},
  Table[{k, Style[ToString[k], heros[22]], {0.014, 0}}, {k, lo, hi, d}]];

logTicks[emin_, emax_, label_: True] := Module[{es, every, subQ, maj, minor},
  es = Range[Ceiling[emin], Floor[emax]];
  subQ = Length[es] < 2;
  every = If[Length[es] > 8, 2, 1];
  maj = If[Length[es] == 0, {},
    Table[{e, If[label && Mod[e - First[es], every] == 0, \
Style[Superscript[10, e], heros[22]], \"\"],
      {0.014, 0}}, {e, es}]];
  minor = Flatten[Table[{e + Log10[k],
      If[label && subQ && MemberQ[{2, 3, 5}, k], Style[Row[{k, \"\[Times]\", \
Superscript[10, e]}], heros[22]], \"\"],
      If[subQ && MemberQ[{2, 3, 5}, k], {0.014, 0}, {0.007, 0}]},
     {e, Floor[emin], Ceiling[emax]}, {k, 2, 9}], 1];
  Join[maj, Select[minor, emin <= #[[1]] <= emax &]]];\
\>", "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"24871f5e-38a5-4630-831b-edc6d8221884"],

Cell["", "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"4631486f-719d-46cf-b12c-3a38cb564fe8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Paneling", "Subtitle",ExpressionUUID->"433b2348-df30-4ddb-a007-63fe5cada635"],

Cell["\<\
panelSize = {640, 520};
panelPadding = {{112, 22}, {84, 16}};
frameLabelOf[x_] := If[x === None, None, Style[x, heros[30]]];

Options[framePanel] = {\"XLabel\" -> None, \"YLabel\" -> None, \"XTicks\" -> \
Automatic,
   \"YTicks\" -> Automatic, \"Size\" -> Automatic, \"Padding\" -> Automatic, \
\"Extra\" -> {}, \"Clip\" -> True};

framePanel[prims_, {x0_, x1_}, {y0_, y1_}, OptionsPattern[]] := Module[{xt, \
yt},
  xt = Replace[OptionValue[\"XTicks\"], Automatic :> linTicks[x0, x1]];
  yt = Replace[OptionValue[\"YTicks\"], Automatic :> linTicks[y0, y1]];
  Graphics[{prims, OptionValue[\"Extra\"]},
   PlotRange -> {{x0, x1}, {y0, y1}}, Frame -> True, Axes -> False,
   FrameStyle -> Directive[Black, AbsoluteThickness[1.5]],
   FrameTicks -> {{yt, blankTicks[yt]}, {xt, blankTicks[xt]}},
   FrameTicksStyle -> heros[22],
   FrameLabel -> {frameLabelOf[OptionValue[\"XLabel\"]], \
frameLabelOf[OptionValue[\"YLabel\"]]},
   LabelStyle -> heros[24], BaseStyle -> herosFont,
   ImageSize -> Replace[OptionValue[\"Size\"], Automatic -> panelSize],
   AspectRatio -> Full, PlotRangePadding -> None,
   ImagePadding -> Replace[OptionValue[\"Padding\"], Automatic -> \
panelPadding],
   PlotRangeClipping -> OptionValue[\"Clip\"], Background -> White]];\
\>", "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"7239fb9e-b991-48d3-860c-53e2f1156e28"],

Cell["", "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"21e59e49-b072-4a8c-82c3-e99b1b9a0ee9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Legends", "Subtitle",ExpressionUUID->"c988b0f8-2f23-447c-a783-7e30229d3631"],

Cell["\<\
lineSwatch[colour_] := Graphics[{colour, AbsoluteThickness[4], Line[{{0, 0}, \
{1, 0}}]},
   ImageSize -> {34, 14}, AspectRatio -> Full, PlotRange -> {{0, 1}, {-1, \
1}},
   PlotRangePadding -> None, ImagePadding -> None];

squareSwatch[colour_] := Graphics[{colour, Rectangle[{-1, -1}, {1, 1}]},
   ImageSize -> {14, 14}, AspectRatio -> Full, PlotRange -> {{-1.6, 1.6}, \
{-1.6, 1.6}},
   PlotRangePadding -> None, ImagePadding -> None];

Options[legendBox] = {\"Pos\" -> {0.97, 0.96}, \"Align\" -> {Right, Top}, \
\"FontSize\" -> 21,
   \"Swatch\" -> lineSwatch, \"MarkerSize\" -> {34, 14}};

(* Built on SwatchLegend: long rectangular markers by default, squares when \
the caller asks for squareSwatch, as the seed-rate panel does. *)
legendBox[entries_, OptionsPattern[]] := Module[{size},
  size = If[OptionValue[\"Swatch\"] === squareSwatch, {14, 14}, \
OptionValue[\"MarkerSize\"]];
  Inset[SwatchLegend[entries[[All, 1]], entries[[All, 2]],
    LegendMarkerSize -> size, LabelStyle -> heros[OptionValue[\"FontSize\"]],
    LegendLayout -> \"Column\", LegendMargins -> 0],
   Scaled[OptionValue[\"Pos\"]], OptionValue[\"Align\"]]];\
\>", "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"75faa4e9-76b4-4493-ab3a-95889e220698"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Spectrum Configuration and Legend", "Subtitle",ExpressionUUID->"a3aac62f-01b7-43d6-a8f7-36c5c589800f"],

Cell["\<\
Options[spectrumPanel] = {\"XLabel\" -> None, \"YLabel\" -> \"Events\", \
\"LogY\" -> True,
   \"XRange\" -> Automatic, \"XTicks\" -> Automatic, \"YFloor\" -> Automatic,
   \"LegendPos\" -> {0.97, 0.96}, \"LegendAlign\" -> {Right, Top}, \
\"LegendSize\" -> 21,
   \"Size\" -> Automatic, \"Padding\" -> Automatic, \"Thickness\" -> 2.2};

spectrumPanel[series_, OptionsPattern[]] := Module[{logQ, xr, allh, pos, \
floor, base, top, yr, tr, prims, legend},
  logQ = OptionValue[\"LogY\"];
  xr = Replace[OptionValue[\"XRange\"],
    Automatic :> {Min[First[#[\"edges\"]] & /@ series], \
Max[Last[#[\"edges\"]] & /@ series]}];
  allh = Join @@ (#[\"heights\"] & /@ series);
  pos = Select[allh, # > 0 &];
  floor = Replace[OptionValue[\"YFloor\"], Automatic :> Min[pos]/2];
  top = If[logQ, 2 Max[pos], 1.12 Max[pos]];
  base = If[logQ, floor, 0];
  yr = If[logQ, {Log10[floor], Log10[top]}, {0, top}];
  tr = If[logQ, {#[[1]], Log10[#[[2]]]} &, # &];
  prims = Table[{s[\"colour\"], \
AbsoluteThickness[OptionValue[\"Thickness\"]],
     Line[Map[tr, stepSegments[s[\"edges\"], s[\"heights\"], base], {2}]]}, \
{s, series}];
  legend = legendBox[{#[\"colour\"], #[\"label\"]} & /@ series,
    \"Pos\" -> OptionValue[\"LegendPos\"], \"Align\" -> \
OptionValue[\"LegendAlign\"],
    \"FontSize\" -> OptionValue[\"LegendSize\"]];
  framePanel[prims, xr, yr, \"XLabel\" -> OptionValue[\"XLabel\"], \"YLabel\" \
-> OptionValue[\"YLabel\"],
   \"XTicks\" -> OptionValue[\"XTicks\"],
   \"YTicks\" -> If[logQ, logTicks[yr[[1]], yr[[2]]], Automatic],
   \"Size\" -> OptionValue[\"Size\"], \"Padding\" -> \
OptionValue[\"Padding\"], \"Extra\" -> legend]];\
\>", "Input",
 CellLabel->"In[56]:=",ExpressionUUID->"7967ae24-5752-4f67-8806-1c358a3ca905"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Line Configuration and Legend", "Subtitle",ExpressionUUID->"8d5082e3-6c59-4f1a-8d5a-88db42bdffa1"],

Cell["\<\
Options[linePanel] = {\"XLabel\" -> None, \"YLabel\" -> None, \"XRange\" -> \
Automatic,
   \"Markers\" -> False, \"LegendPos\" -> {0.97, 0.96}, \"LegendAlign\" -> \
{Right, Top},
   \"Size\" -> Automatic, \"Padding\" -> Automatic};

linePanel[series_, OptionsPattern[]] := Module[{pts, xr, ymax, prims, \
legend},
  pts = #[\"points\"] & /@ series;
  xr = Replace[OptionValue[\"XRange\"], Automatic :> {Min[#[[All, 1]] & /@ \
pts], Max[#[[All, 1]] & /@ pts]}];
  ymax = Max[#[[All, 2]] & /@ pts];
  prims = Table[{series[[i]][\"colour\"], AbsoluteThickness[2.2], \
Line[pts[[i]]],
     If[OptionValue[\"Markers\"], {PointSize[0.011], Point[pts[[i]]]}, \
Nothing]}, {i, Length[series]}];
  legend = legendBox[{#[\"colour\"], #[\"label\"]} & /@ series,
    \"Pos\" -> OptionValue[\"LegendPos\"], \"Align\" -> \
OptionValue[\"LegendAlign\"]];
  framePanel[prims, xr, {0, 1.15 ymax}, \"XLabel\" -> \
OptionValue[\"XLabel\"],
   \"YLabel\" -> OptionValue[\"YLabel\"], \"Size\" -> OptionValue[\"Size\"],
   \"Padding\" -> OptionValue[\"Padding\"], \"Extra\" -> legend]];\
\>", "Input",
 CellLabel->"In[59]:=",ExpressionUUID->"0e7a53be-21f8-4ac4-81b5-c260c7f2aeb6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Occupancy Heat Maps", "Subtitle",ExpressionUUID->"cb4a4912-09fb-4e5c-bcd8-e52fd0ac0c03"],

Cell["\<\
seqRainbowPuBr = {\"#6F4C9B\", \"#6059A9\", \"#5568B8\", \"#4E79C5\", \
\"#4D8AC6\", \"#4E96BC\", \"#549EB3\", \"#59A5A9\", \"#60AB9E\", \"#69B190\", \
\"#77B77D\", \"#8CBC68\", \"#A6BE54\", \"#BEBC48\", \"#D1B541\", \"#DDAA3C\", \
\"#E49C39\", \"#E78C35\", \"#E67932\", \"#E4632D\", \"#DF4828\", \"#DA2222\", \
\"#B8221E\", \"#95211B\", \"#721E17\", \"#521A13\"};
seqIridescent = {\"#A8D8DC\", \"#9BD2E1\", \"#8DCBE4\", \"#81C4E7\", \
\"#7BBCE7\", \"#7EB2E4\", \"#88A5DD\", \"#9398D2\", \"#9B8AC4\", \"#9D7DB2\", \
\"#9A709E\", \"#906388\", \"#805770\", \"#684957\", \"#46353A\"};
seqStops = RGBColor /@ seqIridescent;
seqLUT = Table[List @@ Blend[seqStops, k/255.], {k, 0, 255}];

occGrid[occ_] := Module[{eLo, eHi, pLo, pHi},
  {eLo, eHi} = MinMax[occ[\"eta\"]]; {pLo, pHi} = MinMax[occ[\"phi\"]];
  {Normal[SparseArray[Transpose[{occ[\"phi\"] - pLo + 1, occ[\"eta\"] - eLo + \
1}] -> N[occ[\"count\"]],
     {pHi - pLo + 1, eHi - eLo + 1}]], {eLo, eHi}, {pLo, pHi}}];

colourBar[{x0_, x1_}, {y0_, y1_}, maxLog_] := Module[{at},
  at[e_] := y0 + (y1 - y0) e/maxLog;
  {Raster[Transpose[{seqLUT}], {{x0, y0}, {x1, y1}}], Black, \
AbsoluteThickness[1.2],
   Line[{{x0, y0}, {x1, y0}, {x1, y1}, {x0, y1}, {x0, y0}}],
   Table[{Line[{{x1, at[e]}, {x1 + 0.3 (x1 - x0), at[e]}}],
     Text[Style[Superscript[10, e], heros[19]], {x1 + 0.6 (x1 - x0), at[e]}, \
{-1, 0}]},
    {e, 0, Floor[maxLog]}]}];

Options[occupancyPanel] = {\"Title\" -> None, \"Size\" -> Automatic};
occupancyPanel[occ_, OptionsPattern[]] := Module[{mat, er, pr, maxLog, idx, \
rgb, x0, x1, y0, y1, w, extra},
  {mat, er, pr} = occGrid[occ];
  maxLog = Max[Log10[Max[mat]], 1.];
  idx = Round[255 Clip[Log10[Clip[mat, {1., Max[mat]}]]/maxLog, {0, 1}]] + 1;
  rgb = MapThread[If[#2 >= 1., seqLUT[[#1]], {1., 1., 1.}] &, {idx, mat}, 2];
  {x0, x1} = {er[[1]] - 0.5, er[[2]] + 0.5}; {y0, y1} = {pr[[1]] - 0.5, \
pr[[2]] + 0.5};
  w = x1 - x0;
  extra = {colourBar[{x1 + 0.05 w, x1 + 0.10 w}, {y0, y1}, maxLog],
    If[OptionValue[\"Title\"] === None, Nothing,
     Inset[Framed[Style[OptionValue[\"Title\"], heros[24], Bold],
       Background -> White, FrameStyle -> Black, FrameMargins -> 6], \
Scaled[{0.035, 0.955}], {Left, Top}]]};
  framePanel[Raster[rgb, {{x0, y0}, {x1, y1}}], {x0, x1}, {y0, y1},
   \"XLabel\" -> \"Hardware \[Eta]\", \"YLabel\" -> \"Hardware \[CurlyPhi]\",
   \"Padding\" -> {{112, 155}, {84, 16}}, \"Clip\" -> False, \"Extra\" -> \
extra,
   \"Size\" -> Replace[OptionValue[\"Size\"], Automatic -> panelSize]]];\
\>", "Input",
 CellLabel->"In[62]:=",ExpressionUUID->"1aab7105-b6b6-4469-949f-7c9a081b45fb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Seed Plots", "Subtitle",ExpressionUUID->"8eb5ac1e-7d10-4159-9c1f-8d31395e4417"],

Cell["\<\
Options[dotChart] = {\"XLabel\" -> None, \"Size\" -> {1020, 1450}, \"NameSize\
\" -> 12,
   \"XRange\" -> Automatic, \"LegendPos\" -> {0.985, 0.015}, \"MarkerSize\" -> \
5.5,
   \"Marker\" -> \"Disk\", \"Padding\" -> Automatic};

markerAt[shape_, size_, pt_] := If[shape === \"Square\",
   Rectangle[Offset[{-size, -size}, pt], Offset[{size, size}, pt]],
   Disk[pt, Offset[{size, size}]]];

dotChart[labels_, series_, OptionsPattern[]] := Module[
  {n, ys, xs, xr, pad, guides, prims, ticks, legend, shown},
  n = Length[labels];
  ys = Reverse[Range[n]];
  xs = Select[Join @@ (#[\"values\"] & /@ series), NumericQ[#] && # > 0 &];
  xr = Replace[OptionValue[\"XRange\"], Automatic :> {Log10[Min[xs]] - 0.18, \
Log10[Max[xs]] + 0.18}];
  pad = 0.006 (xr[[2]] - xr[[1]]);
  guides = {GrayLevel[0.45], AbsoluteThickness[0.7], AbsoluteDashing[{3, 3}],
    Line[Table[{{xr[[1]] + pad, y}, {xr[[2]] - pad, y}}, {y, ys}]]};
  prims = Table[Module[{s = series[[i]], rows},
     rows = Select[Transpose[{s[\"values\"], ys + s[\"dy\"],
        If[ListQ[s[\"colour\"]], s[\"colour\"], ConstantArray[s[\"colour\"], \
n]]}],
       NumericQ[#[[1]]] && #[[1]] > 0 &];
     ({#[[3]], markerAt[OptionValue[\"Marker\"], OptionValue[\"MarkerSize\"],
         {Log10[#[[1]]], #[[2]]}]} & /@ rows)],
   {i, Length[series]}];
  ticks = Table[{ys[[i]], Style[labels[[i]], \
heros[OptionValue[\"NameSize\"]]], {0.006, 0}}, {i, n}];
  shown = Select[series, #[\"label\"] =!= \"\" &];
  legend = If[shown === {}, {},
    legendBox[{#[\"colour\"], #[\"label\"]} & /@ shown, \"Pos\" -> \
OptionValue[\"LegendPos\"],
     \"Align\" -> {Right, Bottom}, \"Swatch\" -> squareSwatch]];
  framePanel[{guides, prims}, xr, {0.3, n + 0.7}, \"XLabel\" -> \
OptionValue[\"XLabel\"],
   \"XTicks\" -> logTicks[xr[[1]], xr[[2]]], \"YTicks\" -> ticks,
   \"Size\" -> OptionValue[\"Size\"], \"Extra\" -> legend,
   \"Padding\" -> Replace[OptionValue[\"Padding\"], Automatic -> {{430, 30}, \
{84, 16}}]]];\
\>", "Input",
 CellLabel->"In[73]:=",ExpressionUUID->"e3713c09-5eb7-4ffc-aeed-8a92ab0270d5"],

Cell["", "Input",
 CellLabel->"In[78]:=",ExpressionUUID->"93cc2db3-2222-45c6-b4e7-1266eb50f568"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Style Additions", "Subtitle",ExpressionUUID->"c99c2f6e-f1ad-43bb-8421-2ac68c21af87"],

Cell["\<\
cmsText[simQ_] := Row[{Style[\"CMS\", heros[26], Bold],
   If[simQ, Style[\" Simulation\", heros[26], Italic], \"\"]}];
tevText = Style[\"13.6 TeV\", heros[26]];

finishPanel[panel_, simQ_: False] := Module[{sz, pad, w, h, hh, xl, xr, yb},
  sz = ImageSize /. Options[panel, ImageSize];
  pad = ImagePadding /. Options[panel, ImagePadding];
  {w, h} = If[ListQ[sz], sz, {sz, sz}];
  hh = h + 18;
  xl = pad[[1, 1]]/w;
  xr = 1 - pad[[1, 2]]/w;
  yb = (h - pad[[2, 2]] + 3)/hh;
  Graphics[{Inset[panel, Scaled[{0.5, 0}], {Center, Bottom}, Scaled[{1, \
h/hh}]],
    Inset[cmsText[simQ], Scaled[{xl, yb}], {Left, Bottom}],
    Inset[tevText, Scaled[{xr, yb}], {Right, Bottom}]},
   PlotRange -> {{0, 1}, {0, 1}}, ImageSize -> {w, hh}, AspectRatio -> hh/w,
   PlotRangePadding -> None, Background -> White, BaseStyle -> herosFont]];

exportFigure[fig_, name_] :=
  Export[FileNameJoin[{plotsDir, name <> \".\" <> ToLowerCase[#]}], fig, #] & \
/@ {\"SVG\", \"PDF\"};

preview[panels_, ncols_: 3] := Magnify[
   GraphicsGrid[Partition[panels, UpTo[ncols]], Background -> White, \
ImageSize -> 300 ncols], 0.9];\
\>", "Input",
 CellLabel->"In[79]:=",ExpressionUUID->"8e1bd6f0-2f65-4394-adb4-dfef6f5bd821"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Figures", "Chapter",ExpressionUUID->"efec4b5a-5e43-4a32-bd71-5815806e0bca"],

Cell[CellGroupData[{

Cell["Figure 2. Zero-bias object kinematics", "Section",ExpressionUUID->"2eb6d29c-57da-4e7a-8323-7354c538727f"],

Cell["\<\
fig2Panels = Table[
   Module[{obj, feat, xlab, csvs, rng, series, panel},
    {obj, feat, xlab} = kinFeatures[[i]];
    csvs = Association[# -> loadCSV[csvPath[#, obj, feat <> \".csv\"]] & /@ \
runs];
    rng = MinMax[Join @@ (#[\"value\"] & /@ Values[csvs])];
    series = Table[Module[{eh = rebin[csvs[r][\"value\"], csvs[r][\"count\"], \
rng]},
       <|\"edges\" -> eh[[1]] scaleOf[csvs[r]], \"heights\" -> eh[[2]],
         \"label\" -> runLabels[r], \"colour\" -> runColours[r]|>], {r, runs}];
    panel = finishPanel[spectrumPanel[series, \"XLabel\" -> xlab, \"YFloor\" \
-> 0.5]];
    exportFigure[panel, \"fig2_\" <> obj <> \"_\" <> feat];
    panel],
   {i, Length[kinFeatures]}];
\
\>", "Input",
 CellChangeTimes->{3.9965966010445137`*^9},
 CellLabel->"In[87]:=",ExpressionUUID->"10ef2aee-bab7-427f-a7f7-cc828d2e97f3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Figure 3. Occupancy in hardware eta and phi", "Section",ExpressionUUID->"e41d553d-2a2b-4a5b-a9a2-914208f5840b"],

Cell["\<\
occObjects = {{\"muons\", \"Muons\"}, {\"jets\", \"Jets\"}, {\"egammas\", \
\"e/\[Gamma]\"}, {\"taus\", \"\[Tau]\"}};
fig3Panels = Table[
   Module[{panel},
    panel = finishPanel[
      occupancyPanel[loadCSV[csvPath[runs[[1]], occObjects[[i, 1]], \
\"occupancy.csv\"]],
       \"Title\" -> occObjects[[i, 2]]]];
    exportFigure[panel, \"fig3_occupancy_\" <> occObjects[[i, 1]]];
    panel],
   {i, Length[occObjects]}];\
\>", "Input",
 CellChangeTimes->{{3.996596604411519*^9, 3.9965966058090067`*^9}},
 CellLabel->"In[89]:=",ExpressionUUID->"cc54a86e-8db5-439a-90e4-d663fca96ffb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Figure 4. Object multiplicities", "Section",ExpressionUUID->"6413bf5f-df23-42a7-ab33-d1b50bd2d95a"],

Cell["\<\
multObjects = {{\"muons\", \"Muons per event\", 0.96}, {\"jets\", \"Jets per \
event\", 0.96},
   {\"egammas\", \"e/\[Gamma] per event\", 0.45}, {\"taus\", \"\[Tau] per \
event\", 0.45}};
fig4Panels = Table[
   Module[{obj, xlab, legendY, csvs, rng, series, panel},
    {obj, xlab, legendY} = multObjects[[i]];
    csvs = Association[# -> loadCSV[csvPath[#, obj, \"multiplicity.csv\"]] & \
/@ runs];
    rng = MinMax[Join @@ (#[\"value\"] & /@ Values[csvs])];
    series = Table[Module[{eh = rebin[csvs[r][\"value\"], csvs[r][\"count\"], \
rng]},
       <|\"edges\" -> eh[[1]], \"heights\" -> eh[[2]], \"label\" -> \
runLabels[r], \"colour\" -> runColours[r]|>],
      {r, runs}];
    panel = finishPanel[
      spectrumPanel[series, \"XLabel\" -> xlab, \"YFloor\" -> 0.5,
       \"XTicks\" -> intTicks[rng[[1]], rng[[2]]], \"LegendPos\" -> {0.97, \
legendY}]];
    exportFigure[panel, \"fig4_multiplicity_\" <> obj];
    panel],
   {i, Length[multObjects]}];\
\>", "Input",
 CellChangeTimes->{{3.996596609168549*^9, 3.996596609439316*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"9082abad-aa36-4061-b17f-dbd4f50771bd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Figure 5. Zero bias against SingleNeutrino", "Section",ExpressionUUID->"b9ed7891-9d0e-4b81-b335-97ba7b8dc573"],

Cell["\<\
fig5Samples = Join[runs, {snSample}];
fig5Label[s_] := If[s === snSample, snLabel, runLabels[s]];
fig5Colour[s_] := If[s === snSample, snColour, runColours[s]];

(* One panel per feature with both runs and SingleNeutrino overlaid; every \
curve is normalised to its own total, so all three are fractions of entries \
on a shared binning. *)
fig5Panels = Table[
   Module[{obj, feat, xlab, csvs, rng, series, panel},
    {obj, feat, xlab} = kinFeatures[[i]];
    csvs = Association[# -> loadCSV[csvPath[#, obj, feat <> \".csv\"]] & /@ \
fig5Samples];
    rng = MinMax[Join @@ (#[\"value\"] & /@ Values[csvs])];
    series = Table[Module[{eh = rebin[csvs[s][\"value\"], csvs[s][\"count\"], \
rng]},
       <|\"edges\" -> eh[[1]] scaleOf[csvs[s]],
         \"heights\" -> eh[[2]]/Total[csvs[s][\"count\"]],
         \"label\" -> fig5Label[s], \"colour\" -> fig5Colour[s]|>], {s, \
fig5Samples}];
    panel = finishPanel[spectrumPanel[series, \"XLabel\" -> xlab,
       \"YLabel\" -> \"Fraction of entries\"]];
    exportFigure[panel, \"fig5_\" <> obj <> \"_\" <> feat];
    panel],
   {i, Length[kinFeatures]}];
preview[fig5Panels, 3]\
\>", "Input",
 CellChangeTimes->{{3.996596612018022*^9, 3.996596612180943*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"2a607e94-48cb-4ff2-a60d-a78378c9b8d9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Figure 6. Seed firing rates", "Section",ExpressionUUID->"40a2ebd2-129f-4f98-b59d-f52f89d18974"],

Cell[CellGroupData[{

Cell["\<\
fig6Panel = Module[{cE, cG, top, gMap},
   cE = loadCSV[csvPath[runs[[1]], \"seeds\", \"seeds.csv\"]];
   cG = loadCSV[csvPath[runs[[2]], \"seeds\", \"seeds.csv\"]];
   top = Take[cE[\"name\"], 40];
   gMap = AssociationThread[cG[\"name\"] -> cG[\"fraction\"]];
   finishPanel[
    dotChart[top,
     {<|\"values\" -> Take[cE[\"fraction\"], 40], \"dy\" -> 0.17,
       \"colour\" -> runColours[runs[[1]]], \"label\" -> \
runLabels[runs[[1]]]|>,
      <|\"values\" -> Lookup[gMap, top, Missing[]], \"dy\" -> -0.17,
       \"colour\" -> runColours[runs[[2]]], \"label\" -> \
runLabels[runs[[2]]]|>},
     \"XLabel\" -> \"Fraction of events firing the seed\", \"Marker\" -> \
\"Square\"]]];
exportFigure[fig6Panel, \"fig6_seed_rates\"];
Magnify[fig6Panel, 0.42]\
\>", "Input",
 CellLabel->"In[94]:=",ExpressionUUID->"bc3d3e50-814b-4c1d-81f2-d26eacb860a3"],

