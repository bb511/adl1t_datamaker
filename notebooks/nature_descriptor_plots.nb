Cell["\<\
tolVibrant = <|
   \"orange\" -> RGBColor[\"#EE7733\"], \"blue\" -> RGBColor[\"#0077BB\"],
   \"cyan\" -> RGBColor[\"#33BBEE\"], \"magenta\" -> RGBColor[\"#EE3377\"],
   \"red\" -> RGBColor[\"#CC3311\"], \"teal\" -> RGBColor[\"#009988\"],
   \"grey\" -> RGBColor[\"#BBBBBB\"], \"black\" -> RGBColor[\"#000000\"]|>;

