tolVibrant[\"blue\"]|>;
runTags = <|runs[[1]] -> \"2025E\", runs[[2]] -> \"2025G\"|>;

snSample = \"SingleNeutrino_E-10-gun\";
snLabel = \"SingleNeutrino\";
snColour = tolVibrant[\"orange\"];

fig8Samples = <|
   snSample -> snColour,
   \"ggH-suep-decay-POWHEGnoISR\" -> tolVibrant[\"magenta\"],
   \"HHHto6B_Par-c3-0-d4-0_TuneCP5_13p6TeV_amcatnlo-pythia8\" -> \
tolVibrant[\"cyan\"],
   \"SUSYGluGluToBBHTo2B_Par-M-1200_TuneCP5_13p6TeV_pythia8\" -> \
tolVibrant[\"red\"],
   \"TTHto2B_Par-MH-125_TuneCP5_13p6TeV_powheg-pythia8\" -> tolVibrant[\"blue\
\"]|>;

sampleLabel[s_] := StringReplace[s, {\"_TuneCP5\" ~~ ___ -> \"\", \"_E-10-gun\
\" -> \"\"}];

etLabel[what_] := Row[{what, \" \", Subscript[Style[\"E\", Italic], \"T\"], \
\" [GeV]\"}];
ptLabel[what_] := Row[{what, \" \", Subscript[Style[\"p\", Italic], \"T\"], \
\" [GeV]\"}];

(* The four particle collections record transverse momentum; only the energy \
sums are transverse energies. *)
kinFeatures = {
   {\"muons\", \"muonIEt\", ptLabel[\"Muon\"]},
   {\"jets\", \"jetIEt\", ptLabel[\"Jet\"]},
   {\"egammas\", \"egIEt\", ptLabel[\"e/\[Gamma]\"]},
   {\"taus\", \"tauIEt\", ptLabel[\"\[Tau]\"]},
   {\"ET\", \"Et\", etLabel[\"Total\"]},
   {\"MET\", \"Et\", etLabel[\"Missing\"]}};\
