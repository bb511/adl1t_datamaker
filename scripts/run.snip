# All examples below are run from the root of the repository, not from scripts/,
# because the default auxiliary paths are relative to the repository root.

# Example to convert a single (real data) file.
./scripts/convert --input_file root://eoscms.cern.ch//eos/cms/store/group/dpg_trigger/comm_trigger/L1Trigger/emsmith/condor/ForAxoTraining_EphZB_2025G_run398183_15_0_10_menu2025_v130_1760965469/0.root  --prescale_file scripts/L1Menus/L1Menu_Collisions2025_v1_3_0.csv --pileup_folder scripts/pileup_files --calosumm_tree_name l1CaloSummaryEmuTree/L1CaloSummaryTree --output_path ./parquet_files/test_data

# Example to convert a single (simulation) file.
./scripts/convert --input_file root://eoscms.cern.ch//eos/cms/store/cmst3/group/l1tr/axol1tl/MC/L1TNtupleRun3-142XWinter25/SingleNeutrino_E-10-gun/mcRun3_Run3Winter24Digi-133X_v8-v2/240125_010155/0000/L1Ntuple_100.root  --prescale_file scripts/L1Menus/L1Menu_Collisions2024_v1_3_0_last.csv --calosumm_tree_name l1CaloSummaryEmuTree/L1CaloSummaryTree --output_path ./parquet_files/test_sim --mc

# Example to convert a folder.
./scripts/convert_folder --folder root://eoscms.cern.ch//eos/cms/store/group/dpg_trigger/comm_trigger/L1Trigger/emsmith/condor/ForAxoTraining_EphZB_2025G_run398183_15_0_10_menu2025_v130_1760965469/  --prescale_file scripts/L1Menus/L1Menu_Collisions2025_v1_3_0.csv --pileup_folder scripts/pileup_files --calosumm_tree_name l1CaloSummaryEmuTree/L1CaloSummaryTree --output_path ./parquet_files --ncores 1

# Example to convert a whole run.
./scripts/convert_run +experiment=EphZB_2025G_run398183 output_root_path=./parquet_files ncores=1

# Example to summarise a folder: figures, REPORT.md and summary.json into its SUMMARY dir.
./scripts/summary --folder ./parquet_files/EphZB_2025G_run398183

# Example to aggregate folders that are already summarised, without measuring them again.
./scripts/summary --folder ./parquet_files/EphZB_2025E_run396102 ./parquet_files/EphZB_2025G_run398183 --reuse --campaign_report ./parquet_files/SUMMARY/zerobias

# Example to summarise a whole run, which also records the provenance from the config.
./scripts/summary_run +experiment=EphZB_2025G_run398183 output_root_path=./parquet_files

# Example to compare two data sets, e.g. a reconversion against the original.
./scripts/summary_comparison --folder1 ./parquet_files/EphZB_2025E_run396102 --folder2 ./parquet_files/EphZB_2025G_run398183 --output_folder ./parquet_files/SUMMARY/2025E_vs_2025G
